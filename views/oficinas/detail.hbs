<h1 class="mb-3">Consulta de oficina</h1>

<div class="card mb-3">
  <div class="card-body">
    <p><strong>ID:</strong> {{oficina.id}}</p>
    <p><strong>Título:</strong> {{oficina.titulo}}</p>
    <p><strong>Responsável:</strong> {{oficina.responsavel}}</p>
    <p><strong>Carga horária:</strong> {{oficina.cargaHoraria}} h</p>
    <p><strong>Inscrições:</strong> {{#if oficina.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}</p>
    <p class="mb-1"><strong>Descrição:</strong></p>
    <pre class="border rounded p-3 bg-light mb-0">{{oficina.descricao}}</pre>
  </div>
</div>

<div class="d-flex gap-2">
  <a class="btn btn-primary" href="/oficinas/{{oficina.id}}/editar">Editar</a>
  <a class="btn btn-secondary" href="/">Voltar</a>
</div>
