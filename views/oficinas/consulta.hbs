<h2 class="mb-4">Consultar Oficina</h2>

<div class="card">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">ID</dt>
      <dd class="col-sm-9">{{oficina.id}}</dd>

      <dt class="col-sm-3">Título</dt>
      <dd class="col-sm-9">{{oficina.titulo}}</dd>

      <dt class="col-sm-3">Responsável</dt>
      <dd class="col-sm-9">{{oficina.responsavel}}</dd>

      <dt class="col-sm-3">Descrição</dt>
      <dd class="col-sm-9"><pre class="mb-0">{{oficina.descricao}}</pre></dd>

      <dt class="col-sm-3">Carga horária</dt>
      <dd class="col-sm-9">{{oficina.cargaHoraria}} h</dd>

      <dt class="col-sm-3">Inscrições</dt>
      <dd class="col-sm-9">
        {{#if oficina.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}
      </dd>
    </dl>
  </div>
</div>

<div class="mt-3">
  <a href="/oficinas/{{oficina.id}}/editar" class="btn btn-warning">Editar</a>
  <a href="/" class="btn btn-secondary">Voltar</a>
</div>